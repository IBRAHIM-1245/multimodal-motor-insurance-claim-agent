      "parameters": {
        "jsCode": "// Turn the error details into a short plain-text Telegram alert (underscores removed: Telegram formatting breaks on them)\nconst e = $input.first().json;\nconst clean = text => String(text ?? '').replace(/_/g, ' ');\n\nconst lines = [\n  'ALERT: ShaikSure workflow failed',\n  `Workflow: ${clean(e.workflow?.name)}`,\n  `Failed node: ${clean(e.execution?.lastNodeExecuted)}`,\n  `Error: ${clean(e.execution?.error?.message).slice(0, 300)}`,\n  `Execution ID: ${e.execution?.id}`,\n  `Time: ${new Date().toISOString()}`,\n];\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
      "id": "d7edc199-7153-4ea1-b0b8-b7864c111cde",
