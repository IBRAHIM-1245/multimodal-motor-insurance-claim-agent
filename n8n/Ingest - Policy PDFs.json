    {
      "parameters": {
        "jsCode": "// The 4 ShaikSure policy PDFs, downloaded from the public GitHub repo\nconst base = \"https://raw.githubusercontent.com/IBRAHIM-1245/multimodal-motor-insurance-claim-agent/main/data/policy_docs/\";\nconst files = [\"shaiksure_policy_wording.pdf\", \"shaiksure_exclusions.pdf\",\n               \"shaiksure_claims_procedure.pdf\", \"shaiksure_addons.pdf\"];\nreturn files.map(name => ({ json: { source: name, url: base + name } }));"
      },
      "id": "19e93514-cb9a-4838-a3cd-4f2ce55dfead",
      "name": "Policy PDF links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "0629cd5e-6d28-43be-8468-5dfa74256d48",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "5e8af035-390f-4382-bbd6-89b8d09c72e7",
      "name": "Extract PDF text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// n8n Code node: split each policy PDF's text into one item per clause (e.g. \"7.5 ...\")\nconst SECTIONS = {\n  1: \"Definitions\", 2: \"Scope of Cover\", 3: \"Limits and Deductibles by Claim Type\",\n  4: \"Depreciation on Parts\", 5: \"How the Claim Amount is Calculated\", 6: \"No Claim Bonus\",\n  7: \"General Exclusions\", 8: \"How to Make a Claim\", 9: \"Add-on Covers\",\n  10: \"Claim Review and Fraud Checks\",\n};\n\nconst output = [];\nconst links = $('Policy PDF links').all();   // same order as the downloaded PDFs\n$input.all().forEach((item, i) => {\n  // Put all text on one line, so it works whether the PDF text has line breaks or not\n  const text = item.json.text.replace(/\\s+/g, \" \");\n  const source = links[i].json.source;\n\n  // A clause starts with a number like 3.3 or 10.2, then a space, then a capital letter\n  const parts = text.split(/(?:^|\\s)(?=\\d{1,2}\\.\\d{1,2} [A-Z])/);\n\n  for (const part of parts) {\n    const match = part.match(/^(\\d{1,2})\\.(\\d{1,2}) /);\n    if (!match) continue;                       // skip the title and notes before the first clause\n    const clauseText = part.replace(/\\s*Section \\d{1,2} - [A-Za-z ,&-]+$/, \"\").trim();  // drop a next-section heading\n    output.push({ json: {\n      text: clauseText,\n      clause: match[1] + \".\" + match[2],\n      section: \"Section \" + match[1] + \" - \" + SECTIONS[match[1]],\n      source: source,\n    }});\n  }\n});\nreturn output;\n"
      },
