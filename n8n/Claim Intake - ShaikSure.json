      "parameters": {
        "jsCode": "// No human review needed: the agent's decision is final\nreturn [{ json: { final_decision: $input.first().json.decision, decided_by: 'agent' } }];\n"
      },
      "id": "b318daee-863d-4fa5-9449-1fed06743f80",
      "name": "Agent Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
