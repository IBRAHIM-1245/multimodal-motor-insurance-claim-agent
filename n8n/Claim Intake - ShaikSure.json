    {
      "parameters": {
        "jsCode": "// One row for the claim_audit table: what the AI decided, what was finally decided, and why\nconst result = $('Assess Claim (Agent API)').first().json;\nconst request = $('Build Claim Request').first().json;\nconst final = $input.first().json;\n\nreturn [{\n  json: {\n    claim_id: result.claim_id,\n    policy_number: request.policy_number,\n    claim_type: result.classification ? result.classification.claim_type : null,\n    ai_decision: result.decision,\n    final_decision: final.final_decision,\n    decided_by: final.decided_by,\n    confidence: result.classification ? result.classification.confidence : null,\n    estimated_cost: result.estimated_cost,\n    payable_amount: final.final_decision === 'reject' ? 0 : result.payable_amount,\n    reasons: (result.reasons || []).join(' | '),\n    flags: (result.flags || []).join(' | '),\n    policy_clauses: (result.clauses || []).map(c => c.clause).join(', '),\n    transcript: request.transcript,\n    damage_report: JSON.stringify(request.damage_report),\n    trace_id: result.trace_id,\n  },\n}];\n"
      },
