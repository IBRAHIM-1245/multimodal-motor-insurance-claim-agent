    {
      "parameters": {
        "jsCode": "// Combine the form answers, the photo analysis and the voice transcript into one request for the agent API\nconst form = $('Claim Form').first().json;\nconst merged = $input.first().json;\n\nlet damageReport = {};\ntry {\n  damageReport = JSON.parse(merged.choices[0].message.content);\n} catch (error) {\n  damageReport = {};          // photo analysis failed: the agent still works, without photo details\n}\n\nreturn [{\n  json: {\n    claim_id: 'CLM-' + $execution.id,\n    policy_number: (form['Policy number'] || '').trim().toUpperCase(),\n    description: form['What happened?'] || '',\n    transcript: merged.text || '',\n    damage_report: damageReport,\n    incident_date: form['Incident date'] || '',\n  },\n}];\n"
      },
