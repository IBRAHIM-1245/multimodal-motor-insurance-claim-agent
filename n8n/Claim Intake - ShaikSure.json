      "parameters": {
        "jsCode": "// The voice note is optional: find it (if uploaded) and give it a fixed name \"voice\"\nconst item = $input.first();\nconst voiceKey = Object.keys(item.binary || {}).find(k => k.toLowerCase().includes('voice'));\n\nif (!voiceKey) {\n  return [{ json: { has_voice: false } }];\n}\nreturn [{ json: { has_voice: true }, binary: { voice: item.binary[voiceKey] } }];\n"
      },
