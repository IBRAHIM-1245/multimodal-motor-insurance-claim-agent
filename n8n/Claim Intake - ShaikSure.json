      "parameters": {
        "jsCode": "// Find the uploaded damage photo, turn it into base64 and build the OpenAI vision request\nconst item = $input.first();\nconst photoKey = Object.keys(item.binary || {}).find(k => k.toLowerCase().includes('photo'));\nif (!photoKey) {\n  throw new Error('No damage photo uploaded');\n}\nconst buffer = await this.helpers.getBinaryDataBuffer(0, photoKey);\nconst mimeType = item.binary[photoKey].mimeType || 'image/jpeg';\nconst description = item.json['What happened?'] || '';\n\n// The part names must match the repair_prices table in Postgres\nconst PARTS = ['front_bumper', 'rear_bumper', 'headlight', 'taillight', 'bonnet', 'front_door', 'rear_door',\n  'side_mirror', 'fender', 'roof', 'boot_lid', 'alloy_wheel', 'radiator', 'windshield', 'rear_windshield',\n  'side_window_glass', 'engine', 'interior_upholstery', 'wiring_harness'];\n\nconst prompt = `You inspect photos for a motor insurance claim. Reply with JSON only, in this shape:\n{\"is_car\": true, \"damaged_parts\": [{\"part\": \"rear_bumper\", \"severity\": \"moderate\"}], \"matches_description\": true, \"summary\": \"one sentence\"}\nRules:\n- is_car: false if the photo does not show a car.\n- part must be one of: ${PARTS.join(', ')}. Ignore anything else.\n- severity: minor = scratch or small dent; moderate = dent or crack that needs repair; severe = crushed, burnt or broken, needs replacement.\n- matches_description: false only if the photo clearly contradicts the customer's description.\n- If no damage is visible (for example the whole car was stolen), return an empty damaged_parts list.`;\n\nreturn [{\n  json: {\n    request_body: {\n      model: 'gpt-4o-mini',\n      temperature: 0,\n      max_tokens: 400,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: prompt },\n        { role: 'user', content: [\n          { type: 'text', text: 'Customer description: ' + description },\n          { type: 'image_url', image_url: { url: `data:${mimeType};base64,${buffer.toString('base64')}`, detail: 'low' } },\n        ] },\n      ],\n    },\n  },\n}];\n"
      },
      "id": "04e0b5c4-7272-4d93-a792-c59859569aed",
      "name": "Prepare Photo",
      "type": "n8n-nodes-base.code",
