    {
      "parameters": {
        "jsCode": "// Build a plain-text Telegram message for the claims adjuster (underscores removed: Telegram formatting breaks on them)\nconst result = $input.first().json;\nconst request = $('Build Claim Request').first().json;\nconst clean = text => String(text ?? '').replace(/_/g, ' ');\n\nconst parts = (request.damage_report.damaged_parts || [])\n  .map(p => `${clean(p.part)} (${p.severity})`).join(', ') || 'none';\n\nconst lines = [\n  `ShaikSure claim needs review: ${result.claim_id}`,\n  `Policy: ${request.policy_number}`,\n  `Claim type: ${clean(result.classification?.claim_type)} (${clean(result.classification?.method)})`,\n  `Customer says: ${result.english_text || request.description}`,\n  `Photo damage: ${parts}`,\n  `Estimated cost: Rs ${result.estimated_cost} | Payable: Rs ${result.payable_amount}`,\n  `Flags: ${(result.flags || []).map(clean).join('; ') || 'none'}`,\n  `Policy rules: ${(result.clauses || []).map(c => c.clause).join(', ')}`,\n  `Agent note: ${clean(result.explanation)}`,\n  `Langfuse trace: ${result.trace_id}`,\n];\nreturn [{ json: { message: lines.join('\\n') } }];\n"
      },
      "id": "d3dc7179-bf64-4c21-af29-3db79a9e6cb4",
      "name": "Build Adjuster Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        192
      ]
    },
