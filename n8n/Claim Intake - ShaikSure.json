    {
      "parameters": {
        "jsCode": "// The adjuster pressed Approve or Reject in Telegram\nconst approved = $input.first().json.data?.approved === true;\nreturn [{ json: { final_decision: approved ? 'approve' : 'reject', decided_by: 'adjuster (Telegram)' } }];\n"
      },
